# Railway variables for CBTC farm worker (copy into Railway dashboard).
# No Next.js / Supabase needed. See docs/FARM-RAILWAY.md

NEXT_PUBLIC_NETWORK=mainnet
BITSAFE_FARMING_ELIGIBLE=1
FARM_MAINNET_CONFIRMED=1
FARM_MAX_SWAPS=0
FARM_DATA_DIR=/data

# WarpX m2m (mainnet)
KEYCLOAK_TOKEN_URL=https://auth.warpx.fivenorth.io/application/o/token/
KEYCLOAK_SCOPE=daml_ledger_api
KEYCLOAK_CLIENT_ID=validator-mainnet-m2m
KEYCLOAK_CLIENT_SECRET=

# Canton parties
CANTON_SWAP_SETTLEMENT_PARTY=oranj-settle-mainnet::1220…
SOLVER_CANTON_PARTY=warpx-mainnet-1::1220…
NEXT_PUBLIC_SOLVER_CANTON=warpx-mainnet-1::1220…

# Fleet JSON — paste minified fleet OR use base64 (see docs/FARM-RAILWAY.md)
# FARM_FLEET_JSON={"network":"mainnet",...}
# FARM_FLEET_JSON_B64=
