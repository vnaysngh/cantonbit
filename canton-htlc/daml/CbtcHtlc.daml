-- CbtcHtlc — Hash-Time-Locked Contract for the Canton leg of an EVM<>Canton
-- atomic swap (Fusion+ / Cancore model). One keccak256 secret unlocks both legs.
--
-- ========================= HOW THIS WORKS (verified) =========================
-- Built on the canonical Splice token standard (hyperledger-labs/splice source,
-- 2026-06). The Splice `Holding` interface has NO public Transfer choice — the
-- registry's `Allocation` primitive is the lock+move mechanism. The authority
-- model (verified from AllocationV1.daml):
--
--   Allocation_ExecuteTransfer  controller = executor + sender + receiver
--       BUT consent is PRE-DELEGATED to the `executor` at allocation time
--       ("Typically this authorization is granted by sender and receiver to the
--        executor as part of the contract coordinating the settlement"), so the
--        executor can fire ExecuteTransfer ALONE afterwards.
--   Allocation_Withdraw         controller = sender ALONE  (unilateral refund)
--
-- THE DESIGN (PATH A — exactly what Cancore does):
--   1. The party giving the Canton asset (the "locker") creates an Allocation via
--      the registry's AllocationFactory_Allocate, naming THIS htlc's `executor`
--      party as the settlement executor, with settleBefore = the timelock. This
--      locks the holding and pre-delegates execute-authority to `executor`.
--   2. They create this HtlcLock, recording the allocationCid + hashLock + timelock.
--   3. Claim(preimage): the receiver (or executor on their behalf) reveals the
--      preimage; we verify keccak256(preimage)==hashLock, then exercise
--      Allocation_ExecuteTransfer → asset moves to receiver. Preimage is now
--      on-ledger for the EVM-side watcher to read and claim the EVM leg.
--   4. Refund: after the timelock, the locker exercises Allocation_Withdraw
--      (sender-only authority) → asset returns to locker. Trustless, unilateral.
--
-- The registry CHOICE-CONTEXT (ExtraArgs) for ExecuteTransfer/Withdraw is fetched
-- off-ledger by the orchestrator (your swap-solver, same as it fetches the
-- transfer-factory context today) and PASSED IN as a choice argument — it cannot
-- be hardcoded in Daml. That is the one off-ledger dependency, by design.
-- ============================================================================

module CbtcHtlc where

import DA.Crypto.Text (keccak256, BytesHex)

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1 (InstrumentId)
import Splice.Api.Token.MetadataV1 (ExtraArgs)

-- ENCODING CONTRACT (verified, T2) — both legs must hash IDENTICAL bytes:
--   EVM   : keccak256(preImage)              over the RAW secret bytes
--   Canton: keccak256(preImageHex)           where preImageHex is the lowercase
--           hex string of those same raw bytes. Daml's DA.Crypto.Text.keccak256
--           takes a BytesHex (hex string), decodes it, and hashes the bytes — so
--           it produces the SAME digest as the EVM raw-bytes keccak.
--   e.g. raw "the-cross-chain-secret-32bytes!!"
--        hex  "7468652d63726f73732d636861696e2d7365637265742d333262797465732121"
--        keccak256(hex) == EVM keccak256(raw)
--                       == 0x94277b389401042e35f8709846050797955e2b321bee500555c2fbdc2f4e9903
-- So `preimage` and `hashLock` below are BOTH lowercase-hex strings.

-- | BINDING CHECK (T5): the wrapped Allocation MUST match the HtlcLock, or the
-- preimage gate is meaningless (a mismatched Allocation could be executed /
-- withdrawn through it). Asserts the Allocation's parties, amount, instrument,
-- and settle window == our lock terms. Called at the start of BOTH choices so
-- neither path can act on a wrong Allocation.
assertBoundTo : Party -> Party -> Party -> Decimal -> InstrumentId -> Time -> AllocationView -> Update ()
assertBoundTo locker receiver executor amount instrumentId unlockTime av = do
  let tl = av.allocation.transferLeg
      st = av.allocation.settlement
  assertMsg "HTLC: Allocation sender != locker"      (tl.sender == locker)
  assertMsg "HTLC: Allocation receiver != receiver"  (tl.receiver == receiver)
  assertMsg "HTLC: Allocation executor != executor"  (st.executor == executor)
  assertMsg "HTLC: Allocation amount != amount"      (tl.amount == amount)
  assertMsg "HTLC: Allocation instrument != instrument" (tl.instrumentId == instrumentId)
  assertMsg "HTLC: unlockTime outlives settleBefore" (unlockTime <= st.settleBefore)

-- | A hash-time-locked wrapper around a Splice `Allocation`. The Allocation
-- (created via the registry) holds the actual locked CBTC/CC; this contract is
-- the cryptographic gatekeeper that only lets it execute on a valid preimage,
-- and lets the locker reclaim it after the timelock.
template HtlcLock
  with
    locker : Party
      -- ^ Gave the Canton asset; gets the refund. Also the Allocation's transferLeg.sender.
      --   (Solver for EVM->Canton swaps; user for Canton->EVM swaps.)
    receiver : Party
      -- ^ Receives the asset on a valid preimage. = the Allocation's transferLeg.receiver.
    executor : Party
      -- ^ Pre-delegated executor of the Allocation (the platform/solver party).
      --   This is the party that can fire Allocation_ExecuteTransfer alone.
    allocationCid : ContractId Allocation
      -- ^ The registry Allocation that locks the actual holding (created in step 1).
    amount : Decimal
      -- ^ The exact transfer amount locked by the Allocation.
    instrumentId : InstrumentId
      -- ^ The exact token instrument locked by the Allocation.
    hashLock : Text
      -- ^ H = keccak256(preimageHex), lowercase hex. MUST equal the EVM leg's
      --   keccak256(rawPreimage). See the ENCODING CONTRACT note above.
    unlockTime : Time
      -- ^ Claim only strictly before; Refund only at/after. The timelock.
      --   SHOULD be <= the Allocation's settleBefore so the registry agrees.
  where
    signatory locker
    -- PARTICIPANT-MANAGED model: the receiver is a LOCAL party on our node (where
    -- this DAR is vetted), so making them an observer is fine — it does NOT hit
    -- NO_SYNCHRONIZER (that only happens for a CROSS-participant observer). The
    -- receiver observes + controls Claim, so they can SEE the contract and exercise
    -- it (supplying the receiver authority Allocation_ExecuteTransfer needs). The
    -- backend signs for them (it holds CanActAs over the hosted party), exactly like
    -- Cancore's participant-managed users. (Loop-wallet users use a separate standard
    -- TransferInstruction_Accept path, not this DAR.)
    observer executor, receiver

    -- | THE RECEIVER reveals the preimage to release the locked CBTC to themselves.
    -- The DAML ledger checks keccak256(preimage)==hashLock, then fires
    -- Allocation_ExecuteTransfer — the receiver's own authority (from exercising
    -- this choice) + the executor/sender pre-delegation satisfy its controllers.
    -- Reveals `preimage` on-ledger so the EVM-side watcher can claim the EVM leg.
    --
    -- `allocationContext` is the registry choice-context for Allocation_ExecuteTransfer.
    choice Claim : Allocation_ExecuteTransferResult
      with
        preimage : BytesHex
          -- ^ Lowercase-hex string of the raw secret bytes (the EVM preImage).
        allocationContext : ExtraArgs
      controller receiver
      do
        now <- getTime
        assertMsg "HTLC: too late (timelock passed)" (now < unlockTime)
        assertMsg "HTLC: bad preimage" (keccak256 preimage == hashLock)
        av <- view <$> fetch allocationCid
        assertBoundTo locker receiver executor amount instrumentId unlockTime av
        -- Fire the real Splice release. Executor authority is pre-delegated, so
        -- this succeeds without sender/receiver having to co-sign here.
        exercise allocationCid Allocation_ExecuteTransfer with extraArgs = allocationContext

    -- | Refund to `locker` at/after the timelock. Uses Allocation_Withdraw, which
    -- is controlled by the sender (= locker) ALONE — a unilateral, trustless
    -- escape hatch needing no one else's cooperation.
    --
    -- `allocationContext` is the registry choice-context for Allocation_Withdraw.
    choice Refund : Allocation_WithdrawResult
      with
        allocationContext : ExtraArgs
      controller locker
      do
        now <- getTime
        assertMsg "HTLC: too early (timelock not reached)" (now >= unlockTime)
        av <- view <$> fetch allocationCid
        assertBoundTo locker receiver executor amount instrumentId unlockTime av
        exercise allocationCid Allocation_Withdraw with extraArgs = allocationContext
