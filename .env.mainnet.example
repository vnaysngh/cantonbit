# OranjSwap — web app (mainnet / Base HTLC stack)
# Setup: cp .env.mainnet.example .env.mainnet
# Run:   npm run dev:mainnet   (real funds — Loop mainnet + Base mainnet)
# Production: paste into Railway Variables before `npm run build:mainnet`
# Optional overrides: .env.local. See docs/ENV.md

# --- Master network switch (Canton + Loop) ---
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_LOOP_NETWORK=mainnet
NEXT_PUBLIC_SWAP_CHAIN=base

# --- Supabase (mainnet/prod project — separate from devnet recommended) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentik / WarpX m2m (mainnet pair — do NOT use _DEVNET vars here) ---
KEYCLOAK_TOKEN_URL=https://auth.warpx.fivenorth.io/application/o/token/
KEYCLOAK_SCOPE=daml_ledger_api
KEYCLOAK_CLIENT_ID=validator-mainnet-m2m
KEYCLOAK_CLIENT_SECRET=

# --- HTLC + EVM (mainnet — fill after deploy, see docs/MAINNET-DEPLOY.md) ---
CBTC_HTLC_PKG_ID=1b2397fd7dcf177d90785059d33780de50936804b145b0fe7275bcf73faf2d28
NEXT_PUBLIC_HTLC_ESCROW=0x52df4a3ee93d7139cd671a5f48d46c29e9549eb4
NEXT_PUBLIC_WBTC_ADDRESS=0x0555E30da8f98308EdB960aa94C0Db47230d2B9c
WBTC_ADDRESS=0x0555E30da8f98308EdB960aa94C0Db47230d2B9c
NEXT_PUBLIC_SOLVER_EVM=0x0B95ec21579aee6Ef7b712976bD86689D68b5A08
NEXT_PUBLIC_SOLVER_CANTON=warpx-mainnet-1::1220517bfd86ef5732610705a35b7b2d56e36112550d6a2b778971dbd099a3d36e99
SOLVER_EVM=0x0B95ec21579aee6Ef7b712976bD86689D68b5A08
SOLVER_CANTON_PARTY=warpx-mainnet-1::1220517bfd86ef5732610705a35b7b2d56e36112550d6a2b778971dbd099a3d36e99

# --- Fees (optional) ---
# PLATFORM_FEE_BPS=100
# NEXT_PUBLIC_FEE_BPS=100

# --- Daemon / cron auth (unique per stack if running devnet + mainnet in parallel) ---
HTLC_DAEMON_SECRET=
CRON_SECRET=

# --- Optional ---
# NEXT_PUBLIC_BITSAFE_API_URL=
# RESEND_API_KEY=
# ALERT_WEBHOOK_URL=
