# CBTC farm bot — standalone worker (no Next.js build).
FROM node:22-slim

WORKDIR /app

# Match repo .npmrc (legacy-peer-deps). Use npm install — not npm ci — so
# minor lock drift between npm 10 (Docker) and npm 11 (dev) cannot fail builds.
COPY package.json package-lock.json .npmrc ./
ENV NODE_ENV=development
ENV NPM_CONFIG_PRODUCTION=false
RUN npm install -g npm@11.12.1 \
  && npm install --include=dev --no-audit --no-fund --legacy-peer-deps

COPY lib ./lib
COPY scripts ./scripts
COPY swap-solver/src/canton.ts ./swap-solver/src/canton.ts
COPY swap-solver/src/retry.ts ./swap-solver/src/retry.ts
COPY tsconfig.json ./

ENV NODE_ENV=production
ENV NEXT_PUBLIC_NETWORK=mainnet
ENV FARM_DATA_DIR=/data

RUN mkdir -p /data

CMD ["npx", "tsx", "scripts/farm/railway-start.mts"]
