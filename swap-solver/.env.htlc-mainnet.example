# HTLC solver daemon — mainnet (Base)
# Setup: cp .env.htlc-mainnet.example .env.htlc-mainnet
# Run:   npm run solver:htlc:mainnet   (loads ../.env.mainnet + this file + ../.env.local)

SWAP_NETWORK=mainnet
ALLOW_MAINNET=true
EVM_CHAIN=base

API_BASE=https://your-mainnet-web-app.example.com
HTLC_DAEMON_SECRET=

ORIGIN_RPC_URL=https://mainnet.base.org
HTLC_ESCROW_ADDRESS=0x52df4a3ee93d7139cd671a5f48d46c29e9549eb4
NEXT_PUBLIC_HTLC_ESCROW=0x52df4a3ee93d7139cd671a5f48d46c29e9549eb4
# Required for canton→evm: solver locks WBTC on EVM at main_locked
WBTC_ADDRESS=0x0555E30da8f98308EdB960aa94C0Db47230d2B9c

# Mainnet-only solver EVM hot key — NEVER reuse devnet key
SOLVER_EVM_PK=

# Only required if this Railway service runs `npm run build`:
# NEXT_PUBLIC_HTLC_ESCROW=<same as HTLC_ESCROW_ADDRESS>

# Optional
# SOLVER_POLL_MS=4000
# ALERT_WEBHOOK_URL=
