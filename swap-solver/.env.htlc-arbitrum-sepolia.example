# HTLC solver daemon — devnet (Arbitrum Sepolia)
# Setup: cp .env.htlc-arbitrum-sepolia.example .env.htlc-arbitrum-sepolia
# Run:   npm run htlc-daemon:arbitrum-sepolia

SWAP_NETWORK=devnet
EVM_CHAIN=arbitrum-sepolia

API_BASE=http://localhost:3000
HTLC_DAEMON_SECRET=

ORIGIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
HTLC_ESCROW_ADDRESS=0xabe67f68b7cc174fc119cbf6daf3f2bebfb565c6
ESCROW_START_BLOCK=282023631

# Same solver hot key as base-sepolia daemon (different chain = separate nonce space).
SOLVER_EVM_PK=

HEALTH_PORT=8082
