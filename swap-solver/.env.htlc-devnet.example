# HTLC solver daemon — devnet (Base Sepolia)
# Setup: cp .env.htlc-devnet.example .env.htlc-devnet
# Run:   npm run solver:htlc   (loads ../.env.devnet + this file)

SWAP_NETWORK=devnet
EVM_CHAIN=base-sepolia

API_BASE=http://localhost:3000
HTLC_DAEMON_SECRET=

ORIGIN_RPC_URL=https://sepolia.base.org
HTLC_ESCROW_ADDRESS=0x1b19a764ab35db1833ae2137544dd84ba5bf8cf1

# Solver EVM hot key (dev/test only — use a dedicated key per environment)
SOLVER_EVM_PK=
# Fallback names accepted by the daemon:
# PRIVATE_KEY=
# AGENT_PRIVATE_KEY=

# Only required if this Railway service runs `npm run build` (Next.js compile):
# NEXT_PUBLIC_HTLC_ESCROW=0x1b19a764ab35db1833ae2137544dd84ba5bf8cf1

# Optional
# SOLVER_POLL_MS=4000
# ALERT_WEBHOOK_URL=
