{
  "name": "oranj-swap-solver",
  "version": "0.0.1",
  "private": true,
  "description": "Single-solver WBTC(Base) → CBTC(Canton) swap solver. Watches the OIF InputSettlerEscrow on Base, delivers CBTC on Canton via the Oranj app's existing flow, attests the fill to a custom oracle, and finalises to release the locked WBTC.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "api": "tsx --env-file=.env --env-file=../.env.local --env-file=.env.mainnet src/serve.ts",
    "watch": "tsx --env-file=.env --env-file=../.env.local --env-file=.env.mainnet src/index.ts",
    "htlc-daemon": "tsx --env-file=../.env.local --env-file=../.env.devnet --env-file=.env.htlc-devnet src/htlc-solver-daemon.mts",
    "htlc-daemon:mainnet": "tsx --env-file=../.env.local --env-file=../.env.mainnet --env-file=.env.htlc-mainnet src/htlc-solver-daemon.mts",
    "canton-swap-daemon": "tsx --env-file=../.env.local --env-file=../.env.devnet src/canton-swap-daemon.mts",
    "api:prod": "tsx src/serve.ts",
    "watch:prod": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
