{
  "name": "oranj-swap-solver",
  "version": "0.0.1",
  "private": true,
  "description": "Background workers for OranjSwap: HTLC WBTC↔CBTC daemon and Loop C2C CBTC↔CC daemon.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "htlc-daemon": "tsx --env-file=../.env.devnet --env-file=.env.htlc-devnet src/htlc-solver-daemon.mts",
    "htlc-daemon:mainnet": "tsx --env-file=../.env.mainnet --env-file=.env.htlc-mainnet src/htlc-solver-daemon.mts",
    "canton-swap-daemon": "tsx --env-file=../.env.devnet src/canton-swap-daemon.mts",
    "canton-swap-daemon:mainnet": "tsx --env-file=../.env.mainnet src/canton-swap-daemon.mts",
    "htlc-daemon:prod": "tsx src/htlc-solver-daemon.mts",
    "canton-swap-daemon:prod": "tsx src/canton-swap-daemon.mts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "tsx": "^4.19.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
