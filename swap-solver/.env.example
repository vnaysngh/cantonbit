# Oranj swap solver — environment template.
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.
# The AGENT_PRIVATE_KEY and KEYCLOAK_CLIENT_SECRET are TREASURY-GRADE.

# devnet | testnet | mainnet. Mainnet additionally requires ALLOW_MAINNET=true.
SWAP_NETWORK=testnet
# ALLOW_MAINNET=true

# --- EVM (Base) side ---
ORIGIN_RPC_URL=https://sepolia.base.org
ESCROW_ADDRESS=0x...
ORACLE_ADDRESS=0x...
WBTC_ADDRESS=0x...
# Block the escrow was deployed at (watcher start point).
ESCROW_START_BLOCK=0
# The agent signer (attest + finalise). Dedicated key, never reused, treasury-grade.
AGENT_PRIVATE_KEY=0x...

# --- Canton side ---
CANTON_LEDGER_HOST=https://ledger-api.validator.devnet.warpx.fivenorth.io
CANTON_REGISTRY_URL=https://api.utilities.digitalasset-dev.com
CANTON_ADMIN_PARTY=cbtc-network::1220...
CANTON_INSTRUMENT_ID=CBTC
# The solver's own cBTC party (the float source).
SOLVER_CANTON_PARTY=cbtc-user-...::1220...
# Authentik client-credentials (same identity family as the Oranj app).
KEYCLOAK_TOKEN_URL=https://auth.warpx.fivenorth.io/application/o/token/
KEYCLOAK_CLIENT_ID=...
KEYCLOAK_CLIENT_SECRET=...
KEYCLOAK_SCOPE=daml_ledger_api

# --- behavior ---
POLL_INTERVAL_MS=15000
STORE_PATH=.oranj-swap/orders.json
