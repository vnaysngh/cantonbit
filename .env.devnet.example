# OranjSwap — web app (devnet / Base Sepolia HTLC stack)
# Setup: cp .env.devnet.example .env.devnet
# Run:   npm run dev:devnet
# Optional overrides: .env.local (applied on top). See docs/ENV.md

# --- Master network switch (Canton + Loop) ---
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_LOOP_NETWORK=devnet
NEXT_PUBLIC_SWAP_CHAIN=base-sepolia

# --- Supabase (dev project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentik / WarpX m2m (devnet pair) ---
KEYCLOAK_TOKEN_URL=https://auth.warpx.fivenorth.io/application/o/token/
KEYCLOAK_SCOPE=daml_ledger_api
KEYCLOAK_CLIENT_ID_DEVNET=validator-devnet-m2m
KEYCLOAK_CLIENT_SECRET_DEVNET=
# Optional fallback when NEXT_PUBLIC_NETWORK=devnet:
# KEYCLOAK_CLIENT_ID=validator-devnet-m2m
# KEYCLOAK_CLIENT_SECRET=

# --- HTLC + EVM (devnet) ---
CBTC_HTLC_PKG_ID=1b2397fd7dcf177d90785059d33780de50936804b145b0fe7275bcf73faf2d28
NEXT_PUBLIC_HTLC_ESCROW=0x1b19a764ab35db1833ae2137544dd84ba5bf8cf1
NEXT_PUBLIC_WBTC_ADDRESS=0x8d587e55236d1d4898e85711f709e53e657413ee
NEXT_PUBLIC_SOLVER_EVM=
NEXT_PUBLIC_SOLVER_CANTON=warpx-devnet-1::1220231c1885f289f90e0d08b448579c31a655b5826802c6d885258a27371039fba9
SOLVER_EVM=
SOLVER_CANTON_PARTY=

# --- C2C settlement vault (required for CBTC↔CC; no TransferPreapproval) ---
# npm run provision-settlement:devnet  →  paste party id here
# CANTON_SWAP_SETTLEMENT_PARTY=oranj-settle-devnet::1220...

# --- Fees (optional) ---
# PLATFORM_FEE_BPS=100
# NEXT_PUBLIC_FEE_BPS=100
# NETWORK_FEE_ENABLED=0
# NEXT_PUBLIC_NETWORK_FEE_ENABLED=0
# NETWORK_FEE_QUOTE_PREVIEW=1   # show fee + bytes in UI without collecting CC
# NETWORK_FEE_RECEIVER_PARTY=warpx-devnet-1::1220...
# NETWORK_FEE_BUFFER_BPS=1500
# NETWORK_FEE_RESERVE_CC=5
# NETWORK_FEE_MAX_BPS_OF_NOTIONAL=250

# --- Daemon / cron auth (generate long random strings) ---
HTLC_DAEMON_SECRET=
CRON_SECRET=

# --- Optional ---
# NEXT_PUBLIC_BITSAFE_API_URL=
# RESEND_API_KEY=
# ALERT_WEBHOOK_URL=
